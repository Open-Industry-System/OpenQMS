# OpenQMS auf dem Raspberry Pi – Vorlage für .env
# Kopieren: cp .env.pi.example .env   und ALLE Platzhalter ersetzen.
# Zufallswerte erzeugen z. B. mit:  openssl rand -hex 32

# Datenbank
POSTGRES_USER=qms
POSTGRES_DB=qms
POSTGRES_PASSWORD=BITTE_AENDERN_langes_zufaelliges_passwort

# Redis
REDIS_PASSWORD=BITTE_AENDERN_langes_zufaelliges_passwort

# Signaturschlüssel für Anmelde-Tokens (mindestens 32 Zeichen, zufällig)
SECRET_KEY=BITTE_AENDERN_openssl_rand_hex_32

# Gültigkeit eines Anmelde-Tokens in Minuten
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Ports auf dem Pi
HTTP_PORT=80
HTTPS_PORT=443

# Nur für HTTPS (CADDYFILE=./deploy/pi/Caddyfile.https): Name, unter dem der Pi
# im Netzwerk erreichbar ist (z. B. openqms.local oder die feste IP).
OPENQMS_HOSTNAME=openqms.local
# CADDYFILE=./deploy/pi/Caddyfile.https

# Optional: KI-Funktionen. Leer lassen = reiner Regel-Engine-Modus.
# Beispiele: LLM_PROVIDER=claude | openai | local (Ollama)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
