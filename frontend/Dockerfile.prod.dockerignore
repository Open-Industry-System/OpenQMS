# Root-context production allowlist: Dockerfile.prod requires only these inputs.
**

# Re-include parent directories so Docker can traverse to build inputs.
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

# Source subtrees may contain checked-out metadata; keep it out of BuildKit.
**/.git
**/.git/**
**/.claude
**/.claude/**
**/.superpowers
**/.superpowers/**
**/.worktrees
**/.worktrees/**

!deploy/
!deploy/Caddyfile

# Keep credentials, generated output, test artifacts, and unrelated content out.
.env
.env.*
**/.env
**/.env.*
frontend/.env
frontend/.env.*
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/*.tsbuildinfo
**/test-results
**/test-results/**
**/coverage
**/coverage/**
**/playwright-report
**/playwright-report/**
**/blob-report
**/blob-report/**
frontend/e2e
frontend/e2e/**
!frontend/e2e/helpers/characteristic-diagnostics.ts
**/*.log
.git
.git/**
.claude
.claude/**
.superpowers
.superpowers/**
backend
backend/**
docs
docs/**
scripts
scripts/**
deploy/**
!deploy/
!deploy/Caddyfile
