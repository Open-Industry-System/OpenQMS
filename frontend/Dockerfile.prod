FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_PUBLIC_DEMO_ENABLED=false
ARG VITE_PUBLIC_DEMO_USERNAME=
ARG VITE_PUBLIC_DEMO_PASSWORD=
ARG VITE_PUBLIC_DEMO_ADDITIONAL_ACCOUNTS=
RUN if [ "$VITE_PUBLIC_DEMO_ENABLED" = "true" ]; then \
      VITE_PUBLIC_DEMO_ENABLED=$VITE_PUBLIC_DEMO_ENABLED \
      VITE_PUBLIC_DEMO_USERNAME=$VITE_PUBLIC_DEMO_USERNAME \
      VITE_PUBLIC_DEMO_PASSWORD=$VITE_PUBLIC_DEMO_PASSWORD \
      VITE_PUBLIC_DEMO_ADDITIONAL_ACCOUNTS="$VITE_PUBLIC_DEMO_ADDITIONAL_ACCOUNTS" \
      npm run build; \
    else \
      VITE_PUBLIC_DEMO_ENABLED=false VITE_PUBLIC_DEMO_USERNAME= VITE_PUBLIC_DEMO_PASSWORD= VITE_PUBLIC_DEMO_ADDITIONAL_ACCOUNTS= npm run build; \
    fi

FROM caddy:2-alpine
ARG RELEASE_SHA
LABEL org.opencontainers.image.revision=$RELEASE_SHA
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80 443 8080
