# Public site and Tailnet endpoints
SITE_ADDRESS=qms.example.test
TAILSCALE_IP=100.64.0.10

# PostgreSQL
POSTGRES_USER=qms
POSTGRES_PASSWORD=REQUIRED_GENERATED_ON_SERVER
POSTGRES_DB=qms
DATABASE_URL=postgresql+asyncpg://qms:REQUIRED_GENERATED_ON_SERVER@db:5432/qms

# Redis
REDIS_PASSWORD=REQUIRED_GENERATED_ON_SERVER
REDIS_URL=redis://:REQUIRED_GENERATED_ON_SERVER@redis:6379/0

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=REQUIRED_GENERATED_ON_SERVER
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
GRAPH_REPOSITORY=neo4j

# Backend runtime
SECRET_KEY=REQUIRED_GENERATED_ON_SERVER
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
TENANT_MODE=single
E2E_MODE=false

# External AI providers are intentionally disabled initially
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=

# Intentionally public Viewer demo values embedded in the browser bundle
VITE_PUBLIC_DEMO_ENABLED=true
VITE_PUBLIC_DEMO_USERNAME=viewer
VITE_PUBLIC_DEMO_PASSWORD=Viewer@2026
