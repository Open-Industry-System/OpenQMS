{
	admin off
	auto_https off
}
:8080 {
	@excel_imports {
		method POST
		path /api/suppliers/import /api/suppliers/import/ /api/iqc/materials/import /api/iqc/materials/import/ /api/spc/inspection-characteristics/*/samples/import /api/spc/inspection-characteristics/*/samples/import/
	}
	request_body @excel_imports {
		max_size 10551296
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}
