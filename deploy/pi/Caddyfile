# Caddy für OpenQMS auf dem Raspberry Pi – HTTP im lokalen Netz (Port 80).
# Für HTTPS siehe deploy/pi/Caddyfile.https und docs/raspberry-pi.md.
{
	admin off
}

(openqms_app) {
	encode zstd gzip

	@excel_imports {
		method POST
		path /api/suppliers/import /api/suppliers/import/ /api/iqc/materials/import /api/iqc/materials/import/ /api/spc/inspection-characteristics/*/samples/import /api/spc/inspection-characteristics/*/samples/import/
	}
	request_body @excel_imports {
		max_size 10551296
	}
	# Alle übrigen API-Anfragen auf 2 MB begrenzen (Schutz vor sehr großen Uploads).
	@other_api {
		path /api/*
		not path /api/suppliers/import* /api/iqc/materials/import* /api/spc/inspection-characteristics/*/samples/import*
	}
	request_body @other_api {
		max_size 2MB
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Interne API-Dokumentation nicht im Netzwerk veröffentlichen.
	handle /docs* {
		respond 404
	}
	handle /openapi.json {
		respond 404
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
		-Server
	}
}

:80 {
	import openqms_app
}
