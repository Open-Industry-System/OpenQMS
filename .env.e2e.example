LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=30
# Host-side helpers (optional; alembic/seed run inside the backend container)
E2E_API_BASE_URL=http://localhost:8001/api
E2E_HOST_DATABASE_URL=postgresql+asyncpg://qms:qms_dev_2026@localhost:5433/qms_e2e
